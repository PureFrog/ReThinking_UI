# Dependencies
/node_modules/
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# OS metadata
.DS_Store

# Local test output
/test-results/
/playwright-report/

# Record-only files: they stay on the machine that made them, not in git.
# Stage screenshots, image-request attachments and templates, raw art deliveries (GPT zone).
/docs/screenshots/
/public/assets/incoming/
/collab/to-gpt/*/
/collab/to-gpt/*.zip
/collab/to-nanobanana/*/
# unit-test scratch folders left by an interrupted run
/.foundation-test-*/
/.vitality-test-*/

# teammate prototypes (own git / secrets)
sonjeol-game/
__MACOSX/
.DS_Store
INVEST_GAME/

# Blender logo layers (tools/blender/logo.py renders them again; the cut WebP are in public/brand)
/docs/mockups/landing/logo3d/layer-*.png
